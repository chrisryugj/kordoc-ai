+/// Width decisions without measuring the text: only a tab's decision needs the
+/// advances (`trace_char_width_decisions` sets it from them), so a caller that never
+/// reads a tab's decision gets the same answers for a fraction of the work.
+pub(crate) fn char_width_decisions_without_advances<'a>(
+    text: &str,
+    style: &'a TextStyle,
+) -> Vec<CharWidthDecision<'a>> {
+    let chars: Vec<char> = text.chars().collect();
+    let cluster_len = build_cluster_len(&chars);
+    let supplemental = super::super::supplemental_metrics::standalone_scalar_mask(text, style);
+    (0..chars.len())
+        .map(|i| {
+            char_width_decision(
+                &chars,
+                &cluster_len,
+                i,
+                style,
+                supplemental.as_ref().is_some_and(|mask| mask[i]),
+            )
+        })
+        .collect()
+}
