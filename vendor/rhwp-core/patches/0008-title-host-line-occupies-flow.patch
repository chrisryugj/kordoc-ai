+                st.record_vpos_ladder_validity(true);
             }
             // 표 문단: Phase 2에서 전환 예정. 현재는 기존 방식 호환용 stub.
             self.typeset_table_paragraph(
@@ -336,6 +333,32 @@ impl TypesetEngine {
                 paragraphs,
