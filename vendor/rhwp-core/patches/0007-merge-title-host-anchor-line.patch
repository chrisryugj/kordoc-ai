+/// 쪽을 연 제목 표 host 에서 글자처럼 취급 표 줄 앞의 저장 줄이 앵커만 담았으면 그
+/// 줄들의 저장 높이(HU). 예전 한/글은 제목 표·그림 앵커를 개체 줄 앞의 빈 줄에 두고
+/// 저장했다. 한/글 2024 는 그 줄을 개체 줄과 합쳐 개체를 제목 표 바로 아래에 두고, 같은
+/// 쪽의 뒤 내용도 그만큼 올린다. 보이는 글자가 있거나 합성 줄이면 합치지 않는다.
+pub(crate) fn title_host_anchor_lines_before_tac_hu(
+    para: &Paragraph,
+    tac_index: usize,
+) -> Option<i32> {
+    if para_has_visible_text(para) {
+        return None;
+    }
+    let Some(Control::Table(tac)) = para.controls.get(tac_index) else {
+        return None;
+    };
+    if !tac.common.treat_as_char
+        || !para.controls.iter().any(|control| {
+            matches!(control, Control::Table(table)
+                if !table.common.treat_as_char
+                    && matches!(table.common.text_wrap, TextWrap::Square)
+                    && matches!(table.common.vert_rel_to, VertRelTo::Page | VertRelTo::Paper))
+        })
+    {
+        return None;
+    }
+    let line = control_line_seg_index(para, tac_index).filter(|line| *line > 0)?;
+    let segs = para.line_segs.get(..=line)?;
+    if segs
+        .iter()
+        .any(|seg| seg.tag & crate::model::paragraph::LineSeg::TAG_IMPLEMENTATION_PROPERTY != 0)
+    {
+        return None;
+    }
+    let delta = segs[line].vertical_pos - segs[0].vertical_pos;
+    (delta > 0).then_some(delta)
+}
+
