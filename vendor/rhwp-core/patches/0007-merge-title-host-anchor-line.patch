+            // 앵커만 든 앞 줄을 개체 줄과 합친 제목 표 host 는 그 줄 높이만큼 뒤 내용을 올린다
+            // (조판이 같은 높이를 회수한다).
+            if page_title_table_keeps_page_base && hcursor.vpos_page_base == Some(0) {
+                if let PageItem::Table {
+                    para_index,
+                    control_index,
+                } = item
+                {
+                    if let Some(lead) = paragraphs.get(*para_index).and_then(|para| {
+                        title_host_anchor_lines_before_tac_hu(para, *control_index)
+                    }) {
+                        hcursor.vpos_page_base = Some(lead);
+                    }
+                }
+            }
             if !heading_shape_keeps_page_base
                 && !resolved_stored_wrap_fragment
                 && !page_title_table_keeps_page_base
