+        if let Some(lead) = merged_lead_hu {
+            // 합친 앞 줄 높이를 흐름에서 회수하고, 같은 쪽 뒤 문단의 저장 원점도 그만큼 옮긴다.
+            st.reclaim_flow_by(hwpunit_to_px(lead, self.dpi));
