+    /// [ieum] 글자 모양 ID 를 표대로 바꾸고 이웃한 같은 모양을 합친다. 비어 있으면 `empty`
+    /// 하나로 채운다.
+    pub fn remap_char_shapes(
+        &mut self,
+        ids: &std::collections::HashMap<u32, u32>,
+        empty: u32,
+    ) -> bool {
+        if self.char_shapes.is_empty() {
+            self.set_single_char_shape(empty);
+            return true;
+        }
+        let mut changed = false;
+        for csr in &mut self.char_shapes {
+            if let Some(&id) = ids.get(&csr.char_shape_id) {
+                if id != csr.char_shape_id {
+                    csr.char_shape_id = id;
+                    changed = true;
+                }
+            }
+        }
+        if changed {
+            self.merge_adjacent_char_shapes();
+        }
+        changed
+    }
