+    /// [ieum] 스타일이 old 에서 new 로 바뀔 때 문단 모양 `current` 가 가질 ID.
+    /// 속성마다 맞추는 규칙은 `ParaShape::restyled` 를 따른다.
+    pub(crate) fn restyled_para_shape_id(&mut self, current: u16, old: u16, new: u16) -> u16 {
+        if current == old {
+            return new;
+        }
+        if old == new {
+            return current;
+        }
+        let shapes = &self.doc_info.para_shapes;
+        let (Some(cur), Some(old_ps), Some(new_ps)) = (
+            shapes.get(current as usize),
+            shapes.get(old as usize),
+            shapes.get(new as usize),
+        ) else {
+            return current;
+        };
+        let merged = cur.restyled(old_ps, new_ps);
+        if let Some(i) = shapes.iter().position(|ps| *ps == merged) {
+            return i as u16;
+        }
+        self.doc_info.para_shapes.push(merged);
+        self.doc_info.raw_stream_dirty = true;
+        (self.doc_info.para_shapes.len() - 1) as u16
+    }
+
+    /// [ieum] 스타일이 old 에서 new 로 바뀔 때 글자 모양 `current` 가 가질 ID.
+    /// 글자 스타일의 글자 모양은 문단 스타일을 따르지 않으므로 그대로 둔다.
+    pub(crate) fn restyled_char_shape_id(&mut self, current: u32, old: u32, new: u32) -> u32 {
+        if current == old {
+            return new;
+        }
+        if old == new
+            || self
+                .doc_info
+                .styles
+                .iter()
+                .any(|s| s.style_type == 1 && s.char_shape_id as u32 == current)
+        {
+            return current;
+        }
+        let shapes = &self.doc_info.char_shapes;
+        let (Some(cur), Some(old_cs), Some(new_cs)) = (
+            shapes.get(current as usize),
+            shapes.get(old as usize),
+            shapes.get(new as usize),
+        ) else {
+            return current;
+        };
+        let merged = cur.restyled(old_cs, new_cs);
+        if let Some(i) = shapes.iter().position(|cs| *cs == merged) {
+            return i as u32;
+        }
+        self.doc_info.char_shapes.push(merged);
+        self.doc_info.raw_stream_dirty = true;
+        (self.doc_info.char_shapes.len() - 1) as u32
+    }
+
+    /// [ieum] 문단의 글자 모양 ID 들을 `restyled_char_shape_id` 로 바꾼 표.
+    pub(crate) fn restyled_char_shape_ids(
+        &mut self,
+        runs: impl IntoIterator<Item = u32>,
+        old: u32,
+        new: u32,
+    ) -> std::collections::HashMap<u32, u32> {
+        let mut ids = std::collections::HashMap::new();
+        for run in runs {
+            if !ids.contains_key(&run) {
+                let id = self.restyled_char_shape_id(run, old, new);
+                ids.insert(run, id);
+            }
+        }
+        ids
+    }
