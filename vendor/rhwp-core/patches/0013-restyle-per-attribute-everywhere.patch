+    /// 고치기 전 스타일의 글자·문단 모양이다.
+    ///
+    /// 한컴 한글 2024 와 같이 본문뿐 아니라 표(겹친 표 포함)·글상자·머리말·꼬리말·각주의
+    /// 문단까지 바꾸고, 직접 서식이 있는 문단은 속성마다 맞춘다(`ParaShape::restyled`).
+    /// 문단 스타일을 고칠 때 글자 스타일을 건 글자는 그대로 두고, 글자 스타일을 고치면 그
+    /// 글자 모양을 쓰는 글자가 따라 바뀐다. 다른 스타일과 글자 모양을 나눠 쓰는 글자
+    /// 스타일은 어느 글자가 그 스타일인지 가릴 수 없어 글자를 바꾸지 않는다.
+    ///
+    /// 종전엔 본문과 바깥 표 칸 문단 가운데 문단 모양이 스타일과 똑같은 것만 바꿨고, 글자
+    /// 스타일을 고쳐도 글자는 그대로였다.
+    pub(crate) fn spread_style_change(&mut self, style_id: usize, old_csid: u32, old_psid: u16) {
+        use crate::model::control::Control;
+        use crate::model::identity::walk::{walk, Node};
+        use crate::model::paragraph::Paragraph;
+        use std::collections::{BTreeSet, HashMap};
+
+        type CellPath = Vec<(usize, usize, usize)>;
+
+        /// 표 칸·글상자 문단 가운데 `affected` 인 것의 경로. 겹친 표와 글상자 안까지 따라간다.
+        fn cell_paragraphs(
+            controls: &[Control],
+            path: &mut CellPath,
+            affected: &dyn Fn(&Paragraph) -> bool,
+            out: &mut Vec<(CellPath, usize)>,
+        ) {
+            for (ci, ctrl) in controls.iter().enumerate() {
+                let lists: Vec<(usize, &[Paragraph])> = match ctrl {
+                    Control::Table(t) => t
+                        .cells
+                        .iter()
+                        .enumerate()
+                        .map(|(i, c)| (i, c.paragraphs.as_slice()))
+                        .collect(),
+                    Control::Shape(s) => crate::document_core::helpers::get_textbox_from_shape(s)
+                        .map(|tb| vec![(0, tb.paragraphs.as_slice())])
+                        .unwrap_or_default(),
+                    _ => continue,
+                };
+                for (cell, paras) in lists {
+                    for (k, p) in paras.iter().enumerate() {
+                        path.push((ci, cell, k));
+                        if affected(p) {
+                            out.push((path.clone(), k));
+                        }
+                        cell_paragraphs(&p.controls, path, affected, out);
+                        path.pop();
+                    }
+                }
+            }
+        }
+
+        let Some(style) = self.document.doc_info.styles.get(style_id).cloned() else {
+            return;
+        };
+        let sid = style_id as u8;
+        let new_csid = style.char_shape_id as u32;
+        let new_psid = style.para_shape_id;
+        let char_style = style.style_type == 1;
+        if char_style {
+            let shared = self
+                .document
+                .doc_info
+                .styles
+                .iter()
+                .enumerate()
+                .any(|(i, s)| i != style_id && s.char_shape_id as u32 == old_csid);
+            if shared || old_csid == new_csid {
+                return;
+            }
+        }
+
+        // 1. 바뀔 모양 ID 를 모은다.
+        let mut psids = BTreeSet::new();
+        let mut runs = BTreeSet::new();
+        if !char_style {
+            for section in &mut self.document.sections {
+                let _ = walk(&mut section.paragraphs, |node| {
+                    if let Node::Paragraph(p) = node {
+                        if p.style_id == sid {
+                            psids.insert(p.para_shape_id);
+                            runs.extend(p.char_shapes.iter().map(|r| r.char_shape_id));
+                        }
+                    }
+                    Ok(())
+                });
+            }
+        }
+        let para_ids: HashMap<u16, u16> = psids
+            .into_iter()
+            .map(|id| {
+                (
+                    id,
+                    self.document.restyled_para_shape_id(id, old_psid, new_psid),
+                )
+            })
+            .collect();
+        let char_ids = if char_style {
+            HashMap::from([(old_csid, new_csid)])
+        } else {
+            self.document
+                .restyled_char_shape_ids(runs, old_csid, new_csid)
+        };
+
+        // 2. 문단에 건다.
+        let doc_info = &self.document.doc_info;
+        let indent = |id: u16| {
+            doc_info
+                .para_shapes
+                .get(id as usize)
+                .map_or(0, |ps| ps.indent)
+        };
+        for section in &mut self.document.sections {
+            let mut touched = false;
+            let _ = walk(&mut section.paragraphs, |node| {
+                if let Node::Paragraph(p) = node {
+                    if char_style {
+                        if !p.char_shapes.is_empty() {
+                            touched |= p.remap_char_shapes(&char_ids, new_csid);
+                        }
+                    } else if p.style_id == sid {
+                        if let Some(&id) = para_ids.get(&p.para_shape_id) {
+                            if id != p.para_shape_id {
+                                restamp_indentation(
+                                    &mut p.line_segs,
+                                    indent(p.para_shape_id),
+                                    indent(id),
+                                );
+                                p.para_shape_id = id;
+                            }
+                        }
+                        p.remap_char_shapes(&char_ids, new_csid);
+                        touched = true;
+                    }
+                }
+                Ok(())
+            });
+            if touched {
+                section.raw_stream = None;
+            }
+        }
+
+        // 3. 바뀐 문단의 줄을 다시 나눈다. 머리말·꼬리말은 그릴 때 영역 폭으로 다시 접는다.
+        let affected = |p: &Paragraph| {
+            if char_style {
+                p.char_shapes.iter().any(|r| r.char_shape_id == new_csid)
+            } else {
+                p.style_id == sid
+            }
+        };
+        let mut body = Vec::new();
+        let mut cells = Vec::new();
+        let mut notes = Vec::new();
+        for (si, section) in self.document.sections.iter().enumerate() {
+            for (pi, para) in section.paragraphs.iter().enumerate() {
+                if affected(para) {
+                    body.push((si, pi));
+                }
+                for (ci, ctrl) in para.controls.iter().enumerate() {
+                    if let Control::Footnote(n) = ctrl {
+                        for (k, p) in n.paragraphs.iter().enumerate() {
+                            if affected(p) {
+                                notes.push((si, pi, ci, k));
+                            }
+                        }
+                    }
+                }
+                let mut found = Vec::new();
+                cell_paragraphs(&para.controls, &mut Vec::new(), &affected, &mut found);
+                cells.extend(found.into_iter().map(|(path, k)| (si, pi, path, k)));
+            }
+        }
+        for (si, pi) in body {
+            self.reflow_body_paragraph(si, pi);
+        }
+        for (si, pi, path, k) in cells {
+            self.reflow_cell_paragraph_by_path(si, pi, &path, k);
+            self.mark_cell_control_dirty(si, pi, path[0].0);
+        }
+        if !notes.is_empty() {
+            // 각주 줄 나누기는 캐시된 모양 표를 읽는다. 새로 만든 모양이 들어가게 먼저 맞춘다.
+            self.rebuild_resolved_styles();
+            for (si, pi, ci, k) in notes {
+                self.reflow_footnote_paragraph(si, pi, ci, k);
+            }
+        }
+    }
