+/// 통째로 고르고, 나머지 비트는 하나씩 고른다. 옛 값과 다른 묶음은 지금 값을, 같은 묶음은
+/// 새 값을 쓴다.
+fn restyled_bits(current: u32, old: u32, new: u32, groups: &[u32]) -> u32 {
+    let mut own = current ^ old;
+    for &mask in groups {
+        if own & mask != 0 {
+            own |= mask;
+        }
+    }
+    (new & !own) | (current & own)
+}
+
+/// [ieum] 스타일을 old 에서 new 로 바꿀 때 문단·글자 모양을 속성마다 맞춘다.
+///
+/// 한컴 한글 2024 의 규칙이다. 문단이 옛 스타일과 같은 값을 가진 속성은 새 스타일 값을
+/// 따르고, 옛 스타일과 다른 값(사용자가 직접 정한 서식)은 남긴다. 스타일을 걸 때와 스타일을
+/// 고쳐 그 스타일의 문단에 퍼뜨릴 때 같은 규칙을 쓴다.
+macro_rules! keep_own {
+    ($out:ident, $current:ident, $old:ident; $($field:ident),* $(,)?) => {
+        $(
+            if $current.$field != $old.$field {
+                $out.$field = $current.$field.clone();
+            }
+        )*
+    };
+}
+
+macro_rules! keep_own_each {
+    ($out:ident, $current:ident, $old:ident; $($field:ident),* $(,)?) => {
+        $(
+            for i in 0..$out.$field.len() {
+                if $current.$field[i] != $old.$field[i] {
+                    $out.$field[i] = $current.$field[i];
+                }
+            }
+        )*
+    };
+}
+
+impl CharShape {
+    /// `self` 는 지금 글자 모양, `old`·`new` 는 옛 스타일과 새 스타일의 글자 모양이다.
+    /// 언어별 값(글꼴·장평·자간·상대 크기·글자 위치)은 언어마다 따로 고른다.
+    pub fn restyled(&self, old: &CharShape, new: &CharShape) -> CharShape {
+        let current = self;
+        let mut out = new.clone();
+        out.raw_data = None;
+        keep_own_each!(out, current, old; font_ids, ratios, spacings, relative_sizes, char_offsets);
+        keep_own!(out, current, old;
+            base_size, italic, bold, underline_type, outline_type, shadow_type,
+            shadow_offset_x, shadow_offset_y, text_color, underline_color, shade_color,
+            shadow_color, border_fill_id, strike_color, strikethrough, emboss, engrave,
+            emphasis_dot, underline_shape, strike_shape, kerning, use_font_space);
+        // 위·아래 첨자는 한 속성이다(둘 중 하나만 켜진다).
+        if (current.subscript, current.superscript) != (old.subscript, old.superscript) {
+            out.subscript = current.subscript;
+            out.superscript = current.superscript;
+        }
+        // 직렬화가 필드에서 다시 채우는 비트도 같은 묶음으로 골라 두어야 같은 모양을 다시
+        // 찾을 수 있다(`PartialEq` 가 `attr` 도 비교한다).
+        out.attr = restyled_bits(
+            current.attr,
+            old.attr,
+            new.attr,
+            &[
+                0x03 << 2,
+                0x0F << 4,
+                0x07 << 8,
+                0x03 << 11,
+                0x07 << 18,
+                0x0F << 21,
+                0x0F << 26,
+            ],
+        );
+        out
+    }
+}
+
+impl ParaShape {
+    /// `self` 는 지금 문단 모양, `old`·`new` 는 옛 스타일과 새 스타일의 문단 모양이다.
+    /// 줄 간격(종류·값)과 문단 머리(종류·수준·번호)는 각각 한 속성으로 고른다.
+    pub fn restyled(&self, old: &ParaShape, new: &ParaShape) -> ParaShape {
+        let current = self;
+        let mut out = new.clone();
+        out.raw_data = None;
+        keep_own!(out, current, old;
+            margin_left, margin_right, indent, spacing_before, spacing_after, alignment,
+            tab_def_id, border_fill_id, border_spacing, break_latin_word);
+        let line = |ps: &ParaShape| {
+            (
+                ps.line_spacing,
+                ps.line_spacing_v2,
+                ps.line_spacing_type,
+                ps.attr3,
+            )
+        };
+        if line(current) != line(old) {
+            out.line_spacing = current.line_spacing;
+            out.line_spacing_v2 = current.line_spacing_v2;
+            out.line_spacing_type = current.line_spacing_type;
+            out.attr3 = current.attr3;
+        }
+        let head = |ps: &ParaShape| (ps.head_type, ps.para_level, ps.numbering_id);
+        let own_head = head(current) != head(old);
+        if own_head {
+            out.head_type = current.head_type;
+            out.para_level = current.para_level;
+            out.numbering_id = current.numbering_id;
+        }
+        out.attr1 = restyled_bits(
+            current.attr1,
+            old.attr1,
+            new.attr1,
+            &[0x03, 0x07 << 2, 0x03 << 5, 0x03 << 20, 0x1F << 23],
+        );
+        // 문단 머리 비트(23~27)는 위에서 고른 필드와 같은 쪽을 따른다.
+        let head_bits = 0x1F << 23;
+        let from = if own_head { current } else { new };
+        out.attr1 = (out.attr1 & !head_bits) | (from.attr1 & head_bits);
+        out.attr2 = restyled_bits(current.attr2, old.attr2, new.attr2, &[0x03]);
+        out
+    }
+}
