+/// [ieum] 스타일 걸기·고치기를 한컴 한글 2024 처럼 속성마다 맞추는지 보는 시험의 공통 준비.
+mod restyle {
+    use super::*;
+    use crate::model::control::Control;
+    use crate::model::paragraph::CharShapeRef;
+    use crate::model::style::{Alignment, ParaShapeMods};
+
+    pub(super) fn table_para(doc: &HwpDocument) -> usize {
+        doc.document.sections[0]
+            .paragraphs
+            .iter()
+            .position(|p| p.controls.iter().any(|c| matches!(c, Control::Table(_))))
+            .expect("표 문단")
+    }
+
+    pub(super) fn table(doc: &mut HwpDocument, para: usize) -> &mut crate::model::table::Table {
+        doc.document.sections[0].paragraphs[para]
+            .controls
+            .iter_mut()
+            .find_map(|c| match c {
+                Control::Table(t) => Some(t.as_mut()),
+                _ => None,
+            })
+            .unwrap()
+    }
+
+    pub(super) fn centered(doc: &mut HwpDocument, base: u16) -> u16 {
+        doc.document.find_or_create_para_shape(
+            base,
+            &ParaShapeMods {
+                alignment: Some(Alignment::Center),
+                ..Default::default()
+            },
+        )
+    }
+
+    pub(super) fn runs(ids: &[(u32, u32)]) -> Vec<CharShapeRef> {
+        ids.iter()
+            .map(|&(start_pos, char_shape_id)| CharShapeRef {
+                start_pos,
+                char_shape_id,
+            })
+            .collect()
+    }
+}
+
+/// [ieum] 직접 서식이 있는 문단에 스타일을 걸면 직접 정한 속성(가운데 정렬·진하게)만 남고
+/// 나머지(여백·글자 크기)는 새 스타일을 따른다. 종전엔 문단 모양을 통째로 남겨 새 스타일의
+/// 여백이 들어가지 않았다.
+#[test]
+fn apply_style_keeps_only_own_attributes() {
+    use crate::model::style::Alignment;
+    let mut doc = HwpDocument::create_empty();
+    doc.create_blank_document_native().unwrap();
+    doc.insert_text_native(0, 0, 0, "가나다라").unwrap();
+    let wide = doc.create_style(r#"{"name":"넓게","type":0}"#) as u32;
+    assert!(doc.update_style_shapes(wide, r#"{"fontSize":1600}"#, r#"{"marginLeft":6000}"#));
+    doc.apply_para_format_native(0, 0, r#"{"alignment":"center"}"#)
+        .unwrap();
+    doc.apply_char_format_native(0, 0, 0, 2, r#"{"bold":true}"#)
+        .unwrap();
+
+    doc.apply_style_native(0, 0, wide as usize).unwrap();
+
+    let info = &doc.document.doc_info;
+    let style = &info.styles[wide as usize];
+    let para = &doc.document.sections[0].paragraphs[0];
+    let ps = &info.para_shapes[para.para_shape_id as usize];
+    let style_ps = &info.para_shapes[style.para_shape_id as usize];
+    assert_eq!(ps.alignment, Alignment::Center, "직접 정한 정렬은 남는다");
+    assert_eq!(ps.margin_left, style_ps.margin_left, "여백은 새 스타일");
+    assert_ne!(style_ps.margin_left, 0);
+    let shapes: Vec<_> = para
+        .char_shapes
+        .iter()
+        .map(|r| (r.char_shape_id, &info.char_shapes[r.char_shape_id as usize]))
+        .collect();
+    let bold: Vec<_> = shapes.iter().filter(|(_, cs)| cs.bold).collect();
+    assert_eq!(bold.len(), 1, "직접 정한 진하게는 남는다");
+    assert_eq!(bold[0].1.base_size, 1600, "글자 크기는 새 스타일");
+    for (id, cs) in &shapes {
+        if !cs.bold {
+            assert_eq!(
+                *id, style.char_shape_id as u32,
+                "직접 서식 없는 글자는 새 스타일 그대로"
+            );
+        }
+    }
+}
