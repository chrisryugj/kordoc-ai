+/// [ieum] 스타일을 고치면 겹친 표 안 문단까지 퍼지고, 직접 서식이 있는 문단은 직접 정한
+/// 속성만 남는다. 글자 스타일을 건 글자는 문단 스타일을 따르지 않고, 글자 스타일을 고치면
+/// 따라 바뀐다. 한컴 한글 2024 에서 같은 고치기를 한 결과와 같다.
+#[test]
+fn edit_style_spreads_like_hangul() {
+    use crate::model::style::Alignment;
+    let mut doc = HwpDocument::create_empty();
+    doc.create_blank_document_native().unwrap();
+    doc.create_table_native(0, 0, 0, 2, 2).expect("표 삽입");
+    let tp = restyle::table_para(&doc);
+    let control = doc.document.sections[0].paragraphs[tp]
+        .controls
+        .iter()
+        .position(|c| matches!(c, crate::model::control::Control::Table(_)))
+        .unwrap();
+    doc.insert_text_in_cell_native(0, tp, control, 2, 0, 0, "가나다라")
+        .unwrap();
+    let emph = doc.create_style(r#"{"name":"강조","type":1}"#) as u32;
+    assert!(doc.update_style_shapes(emph, r#"{"bold":true}"#, ""));
+
+    let base = doc.document.doc_info.styles[0].clone();
+    let emph_cs = doc.document.doc_info.styles[emph as usize].char_shape_id as u32;
+    assert_ne!(emph_cs, base.char_shape_id as u32);
+    let own = restyle::centered(&mut doc, base.para_shape_id);
+    {
+        let table = restyle::table(&mut doc, tp);
+        let nested = crate::model::control::Control::Table(Box::new(table.clone()));
+        for cell in table.cells.iter_mut() {
+            cell.paragraphs[0].style_id = 0;
+        }
+        table.cells[0].paragraphs[0].controls.push(nested);
+        table.cells[1].paragraphs[0].para_shape_id = own;
+        table.cells[2].paragraphs[0].char_shapes =
+            restyle::runs(&[(0, base.char_shape_id as u32), (2, emph_cs)]);
+    }
+
+    assert!(doc.update_style_shapes(0, r#"{"fontSize":1600}"#, r#"{"marginLeft":6000}"#));
+
+    let edited = doc.document.doc_info.styles[0].clone();
+    let info = doc.document.doc_info.clone();
+    let table = restyle::table(&mut doc, tp).clone();
+    let nested = match &table.cells[0].paragraphs[0].controls[0] {
+        crate::model::control::Control::Table(t) => t.cells[0].paragraphs[0].clone(),
+        _ => panic!("겹친 표"),
+    };
+    assert_eq!(nested.para_shape_id, edited.para_shape_id, "겹친 표 문단");
+    assert_eq!(
+        nested.char_shapes[0].char_shape_id,
+        edited.char_shape_id as u32
+    );
+    let own_ps = &info.para_shapes[table.cells[1].paragraphs[0].para_shape_id as usize];
+    assert_eq!(
+        own_ps.alignment,
+        Alignment::Center,
+        "직접 정한 정렬은 남는다"
+    );
+    assert_eq!(
+        own_ps.margin_left, info.para_shapes[edited.para_shape_id as usize].margin_left,
+        "여백은 고친 스타일"
+    );
+    let mixed = &table.cells[2].paragraphs[0].char_shapes;
+    assert_eq!(mixed[0].char_shape_id, edited.char_shape_id as u32);
+    assert_eq!(mixed[1].char_shape_id, emph_cs, "글자 스타일 글자는 그대로");
+
+    assert!(doc.update_style_shapes(emph, r#"{"italic":true}"#, ""));
+    let emph_now = doc.document.doc_info.styles[emph as usize].char_shape_id as u32;
+    let table = restyle::table(&mut doc, tp).clone();
+    let run = table.cells[2].paragraphs[0].char_shapes[1].char_shape_id;
+    assert_eq!(run, emph_now, "글자 스타일을 고치면 그 글자도 바뀐다");
+    let cs = &doc.document.doc_info.char_shapes[run as usize];
+    assert!(cs.bold && cs.italic);
+}
