+/// 꼬리말 안 용지 기준 글상자(쪽 번호 상자 등)도 꼬리말 틀에서 잰다. 한/글 2024 PDF
+/// 실측: 오프셋 (3000, 1000)HU 사각형은 (본문 왼쪽 + 40.0, 본문 아래끝 + 13.3). 종전
+/// rhwp 는 용지 원점에서 재어 쪽 맨 위(40.0, 13.3)에 그렸다.
+#[test]
+fn footer_paper_relative_shape_uses_footer_frame_origin() {
+    let (frame_x, frame_y, _, _) = footer_frame_px();
+    let tree = render_tree_with_footer_control(Control::Shape(Box::new(ShapeObject::Rectangle(
+        RectangleShape {
+            common: CommonObjAttr {
+                width: 20_000,
+                height: 1_200,
+                horizontal_offset: 3_000,
+                vertical_offset: 1_000,
+                horz_rel_to: HorzRelTo::Paper,
+                vert_rel_to: VertRelTo::Paper,
+                text_wrap: TextWrap::InFrontOfText,
+                ..Default::default()
+            },
+            ..Default::default()
+        },
+    ))));
+    fn find(node: &RenderNode) -> Option<BoundingBox> {
+        if matches!(node.node_type, RenderNodeType::Rectangle(_)) {
+            return Some(node.bbox);
+        }
+        node.children.iter().find_map(find)
+    }
+    let footer = tree
+        .root
+        .children
+        .iter()
+        .find(|node| matches!(node.node_type, RenderNodeType::Footer))
+        .expect("footer node should be rendered");
+    let bbox = find(footer).expect("footer rectangle should be rendered");
+    assert!((bbox.x - (frame_x + hwpunit_to_px(3_000, DEFAULT_DPI))).abs() < 0.01);
+    assert!((bbox.y - (frame_y + hwpunit_to_px(1_000, DEFAULT_DPI))).abs() < 0.01);
+}
