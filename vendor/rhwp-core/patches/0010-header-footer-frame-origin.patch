+/// 머리말·꼬리말 표 시험용 1×1 부동 표 (20000×2000 HU, 글앞으로).
+fn header_footer_float_table(
+    vert_rel_to: VertRelTo,
+    horz_rel_to: HorzRelTo,
+    vert_align: VertAlign,
+    horz_align: HorzAlign,
+    vertical_offset: i32,
+    horizontal_offset: i32,
+) -> Control {
+    Control::Table(Box::new(Table {
+        row_count: 1,
+        col_count: 1,
+        common: CommonObjAttr {
+            width: 20_000,
+            height: 2_000,
+            vertical_offset: vertical_offset as u32,
+            horizontal_offset: horizontal_offset as u32,
+            vert_rel_to,
+            horz_rel_to,
+            vert_align,
+            horz_align,
+            text_wrap: TextWrap::InFrontOfText,
+            ..Default::default()
+        },
+        cells: vec![Cell {
+            row: 0,
+            col: 0,
+            row_span: 1,
+            col_span: 1,
+            width: 20_000,
+            height: 2_000,
+            paragraphs: vec![Paragraph::default()],
+            ..Default::default()
+        }],
+        ..Default::default()
+    }))
+}
+
+fn render_tree_with_footer_control(control: Control) -> PageRenderTree {
+    use crate::model::header_footer::Footer;
+    use crate::renderer::pagination::HeaderFooterRef;
+
+    let engine = LayoutEngine::with_default_dpi();
+    let layout = PageLayoutInfo::from_page_def_default(&a4_page_def(), &ColumnDef::default());
+    let paragraphs = vec![Paragraph {
+        controls: vec![Control::Footer(Box::new(Footer {
+            paragraphs: vec![Paragraph {
+                controls: vec![control],
+                ..Default::default()
+            }],
+            ..Default::default()
+        }))],
+        ..Default::default()
+    }];
+    let page_content = PageContent {
+        page_index: 0,
+        page_number: 1,
+        page_number_restarted: false,
+        section_index: 0,
+        layout,
+        column_contents: Vec::new(),
+        active_header: None,
+        active_footer: Some(HeaderFooterRef {
+            para_index: 0,
+            control_index: 0,
+            source_section_index: 0,
+            table_path: Vec::new(),
+        }),
+        page_number_pos: None,
+        page_hide: None,
+        footnotes: Vec::new(),
+        active_master_page: None,
+        extra_master_pages: Vec::new(),
+        ladder_band_tables: Vec::new(),
+    };
+    engine.build_render_tree(
+        &page_content,
+        &paragraphs,
+        &paragraphs,
+        &paragraphs,
+        &[],
+        &ResolvedStyleSet::default(),
+        &FootnoteShape::default(),
+        &[],
+        None,
+        &[],
+        None,
+        0,
+        &[],
+    )
+}
+
+fn first_footer_table_bbox(tree: &PageRenderTree) -> BoundingBox {
+    fn find(node: &RenderNode) -> Option<BoundingBox> {
+        if matches!(node.node_type, RenderNodeType::Table(_)) {
+            return Some(node.bbox);
+        }
+        node.children.iter().find_map(find)
+    }
+    let footer = tree
+        .root
+        .children
+        .iter()
+        .find(|node| matches!(node.node_type, RenderNodeType::Footer))
+        .expect("footer node should be rendered");
+    find(footer).expect("footer table should be rendered")
+}
+
+/// 한/글 2024 의 꼬리말 틀: 본문 왼쪽·본문 폭, 본문 아래끝에서 꼬리말 여백 높이.
+fn footer_frame_px() -> (f64, f64, f64, f64) {
+    let page = a4_page_def();
+    let px = |hu: u32| hwpunit_to_px(hu as i32, DEFAULT_DPI);
+    (
+        px(page.margin_left),
+        px(page.height - page.margin_bottom - page.margin_footer),
+        px(page.width - page.margin_left - page.margin_right),
+        px(page.margin_footer),
+    )
+}
+
+/// 머리말 안 용지 기준 표도 그림(#6608)처럼 머리말 틀 원점에서 오프셋을 잰다.
+/// 실문서: 교재 머리말 표(용지 기준 세로 −위 여백, 가로 0)를 한/글 2024 는 쪽 맨 위,
+/// 본문 왼쪽 여백 선에 그린다. 종전 rhwp 는 용지 원점에서 재어 표가 쪽 위로 나가 잘렸다.
+#[test]
+fn header_paper_relative_table_uses_header_frame_origin() {
+    let page = a4_page_def();
+    let tree = render_tree_with_header_control(header_footer_float_table(
+        VertRelTo::Paper,
+        HorzRelTo::Paper,
+        VertAlign::Top,
+        HorzAlign::Left,
+        -(page.margin_top as i32),
+        0,
+    ));
+    let bbox = first_header_child_bbox(&tree, |node_type| {
+        matches!(node_type, RenderNodeType::Table(_))
+    });
+    let header_area =
+        PageLayoutInfo::from_page_def_default(&page, &ColumnDef::default()).header_area;
+    assert!((bbox.x - header_area.x).abs() < 0.01, "x={}", bbox.x);
+    assert!(bbox.y.abs() < 0.01, "y={}", bbox.y);
+}
+
+/// 꼬리말 안 용지·쪽 기준 표는 꼬리말 틀 원점에서 잰다. 한/글 2024 PDF 실측
+/// (A4, 꼬리말 표 오프셋 (3000, 1000)HU): 용지·쪽 기준 모두 (138.0, 920.0)px — 본문
+/// 왼쪽 98.3 + 40.0, 본문 아래끝 907.1 + 13.3. 종전 rhwp 는 용지 기준을 쪽 맨 위
+/// (40.0, 13.3), 쪽 기준을 본문 위끝(138.3, 138.0)에 그렸다.
+#[test]
+fn footer_paper_and_page_relative_tables_use_footer_frame_origin() {
+    let (frame_x, frame_y, _, _) = footer_frame_px();
+    for rel in [
+        (VertRelTo::Paper, HorzRelTo::Paper),
+        (VertRelTo::Page, HorzRelTo::Page),
+    ] {
+        let tree = render_tree_with_footer_control(header_footer_float_table(
+            rel.0,
+            rel.1,
+            VertAlign::Top,
+            HorzAlign::Left,
+            1_000,
+            3_000,
+        ));
+        let bbox = first_footer_table_bbox(&tree);
+        assert!(
+            (bbox.x - (frame_x + hwpunit_to_px(3_000, DEFAULT_DPI))).abs() < 0.01,
+            "{rel:?} x={}",
+            bbox.x
+        );
+        assert!(
+            (bbox.y - (frame_y + hwpunit_to_px(1_000, DEFAULT_DPI))).abs() < 0.01,
+            "{rel:?} y={}",
+            bbox.y
+        );
+    }
+}
+
+/// 꼬리말 틀의 아래끝은 꼬리말 여백까지다(아래 여백 끝이 아니다). 한/글 2024 PDF 실측
+/// (A4, 꼬리말 5mm·아래 여백 52mm, 아래·오른쪽 정렬): (375.5, 909.5)px = 틀 오른쪽 끝
+/// − 표 폭, 본문 아래끝 907.1 + 꼬리말 18.9 − 표 높이 16.0. 종전 rhwp 는 용지 오른쪽
+/// 아래 구석(527.0, 1105.4)에 그렸다.
+#[test]
+fn footer_bottom_right_table_aligns_inside_footer_band() {
+    let (frame_x, frame_y, frame_w, frame_h) = footer_frame_px();
+    let tree = render_tree_with_footer_control(header_footer_float_table(
+        VertRelTo::Paper,
+        HorzRelTo::Paper,
+        VertAlign::Bottom,
+        HorzAlign::Right,
+        0,
+        0,
+    ));
+    let bbox = first_footer_table_bbox(&tree);
+    let table_w = hwpunit_to_px(20_000, DEFAULT_DPI);
+    let table_h = hwpunit_to_px(2_000, DEFAULT_DPI);
+    assert!(
+        (bbox.x - (frame_x + frame_w - table_w)).abs() < 0.01,
+        "x={}",
+        bbox.x
+    );
+    assert!(
+        (bbox.y - (frame_y + frame_h - table_h)).abs() < 0.01,
+        "y={}",
+        bbox.y
+    );
+}
