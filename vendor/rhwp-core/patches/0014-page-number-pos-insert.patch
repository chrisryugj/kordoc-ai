@@ -465,3 +465,115 @@ impl crate::document_core::DocumentCore {
         )))
     }
 }
+
+impl crate::document_core::DocumentCore {
+    /// 구역의 쪽 번호 위치(`pgnp`)를 정한다 — 한글의 [쪽 번호 매기기].
+    ///
+    /// 한글 2024 실측: 쪽 번호 위치는 구역마다 하나이고, 커서가 어디에 있든 구역 첫 문단의
+    /// 구역·단 정의 바로 뒤에 들어간다. 이미 있으면 새로 넣지 않고 그 설정을 바꾼다.
+    /// 줄표가 없으면 대시 문자는 0이다(HWPX `sideChar=""`).
+    pub fn set_page_number_pos_native(
+        &mut self,
+        section_idx: usize,
+        format: u8,
+        position: u8,
+        dash: bool,
+    ) -> Result<String, crate::error::HwpError> {
+        use crate::error::HwpError;
+        use crate::model::control::{Control, PageNumberPos};
+
+        if section_idx >= self.document.sections.len() {
+            return Err(HwpError::RenderError(format!(
+                "구역 인덱스 {} 범위 초과",
+                section_idx
+            )));
+        }
+        if self.document.sections[section_idx].paragraphs.is_empty() {
+            return Err(HwpError::RenderError("구역에 문단이 없음".to_string()));
+        }
+        let setting = PageNumberPos {
+            format,
+            position,
+            user_symbol: '\0',
+            prefix_char: '\0',
+            suffix_char: '\0',
+            dash_char: if dash { '-' } else { '\0' },
+        };
+
+        self.document.sections[section_idx].raw_stream = None;
+        let section = &mut self.document.sections[section_idx];
+        let existing = section.paragraphs.iter_mut().find_map(|para| {
+            para.controls.iter_mut().find_map(|control| match control {
+                Control::PageNumberPos(pnp) => Some(pnp),
+                _ => None,
+            })
+        });
+        let replaced = if let Some(pnp) = existing {
+            // 사용자 기호·앞뒤 장식은 이 창이 다루지 않으므로 원래 값을 둔다
+            pnp.format = setting.format;
+            pnp.position = setting.position;
+            pnp.dash_char = setting.dash_char;
+            true
+        } else {
+            let paragraph = &mut section.paragraphs[0];
+            let insert_idx = paragraph
+                .controls
+                .iter()
+                .take_while(|c| matches!(c, Control::SectionDef(_) | Control::ColumnDef(_)))
+                .count();
+            paragraph.align_ctrl_data_records();
+            paragraph
+                .controls
+                .insert(insert_idx, Control::PageNumberPos(setting));
+            paragraph.ctrl_data_records.insert(insert_idx, None);
+            // 앞선 정의들처럼 첫 글자 앞 자리(8 유닛)를 차지한다
+            paragraph.shift_for_inline_control_insert(insert_idx, 0);
+            paragraph.char_count += 8;
+            paragraph.control_mask |= 1u32 << 0x0015;
+            paragraph.has_para_text = true;
+            self.shift_active_field_for_control_insert(section_idx, 0, insert_idx);
+            false
+        };
+
+        if !replaced {
+            self.reflow_paragraph(section_idx, 0);
+        }
+        self.recompose_section(section_idx);
+        self.paginate_if_needed();
+        self.invalidate_page_tree_cache();
+
+        Ok(crate::document_core::helpers::json_ok_with(&format!(
+            "\"replaced\":{}",
+            replaced
+        )))
+    }
+
+    /// 구역의 쪽 번호 위치. 없으면 `pageNumber` 가 null 이다.
+    pub fn get_page_number_pos_native(
+        &self,
+        section_idx: usize,
+    ) -> Result<String, crate::error::HwpError> {
+        use crate::error::HwpError;
+        use crate::model::control::Control;
+
+        let section = self.document.sections.get(section_idx).ok_or_else(|| {
+            HwpError::RenderError(format!("구역 인덱스 {} 범위 초과", section_idx))
+        })?;
+        let found = section.paragraphs.iter().find_map(|para| {
+            para.controls.iter().find_map(|control| match control {
+                Control::PageNumberPos(pnp) => Some(pnp),
+                _ => None,
+            })
+        });
+        let body = match found {
+            Some(pnp) => format!(
+                "\"pageNumber\":{{\"format\":{},\"position\":{},\"dash\":{}}}",
+                pnp.format,
+                pnp.position,
+                pnp.dash_char != '\0'
+            ),
+            None => "\"pageNumber\":null".to_string(),
+        };
+        Ok(crate::document_core::helpers::json_ok_with(&body))
+    }
+}
