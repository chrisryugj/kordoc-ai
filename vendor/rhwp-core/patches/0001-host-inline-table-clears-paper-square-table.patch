+    /// 같은 host 의 쪽·종이 기준 어울림 표 상자 중 아직 등록되지 않은 것.
+    ///
+    /// 저장 host 는 뒤 문단을 위해 이 상자를 등록하지 않는다 — 뒤 문단의 위치는 저장
+    /// vpos 가 증언한다. 그러나 host 자신의 글자처럼 취급 개체 줄도 이 상자를 피해야
+    /// 한다. 한글은 옆에 들어갈 폭이 없으면 그 줄을 상자 아래에 둔다(저장 vpos 가 상자
+    /// 바닥과 같다). 이 줄의 배치에만 쓰고 뒤 문단의 저장 경로는 바꾸지 않는다.
+    /// 지금 단에 통째로 놓인 표만 본다. 여러 쪽에 걸친 표나 앞 쪽에 놓인 표의 상자는
+    /// 쪽마다 같은 자리로 계산되지만 이 쪽을 차지하지 않는다.
+    pub(super) fn host_page_anchored_square_exclusions(
+        &self,
+        para_index: usize,
+        para: &crate::model::paragraph::Paragraph,
+        control_index: usize,
+    ) -> Vec<crate::renderer::layout_frame::FrameExclusion> {
+        let column = self.inline_flow_column();
+        let paper = LayoutRect {
+            x: 0.0,
+            y: 0.0,
+            width: self.data.layout.page_width,
+            height: self.data.layout.page_height,
+        };
+        let frame = crate::renderer::float_placement::ObjectPlacementFrame {
+            container: &column,
+            column: &column,
+            body: &self.data.layout.body_area,
+            paper: &paper,
+            paragraph_y: column.y,
+            alignment: crate::model::style::Alignment::Left,
+            dpi: self.data.layout.dpi,
+        };
+        para.controls
+            .iter()
+            .enumerate()
+            .filter(|(index, _)| {
+                *index != control_index
+                    && !self
+                        .data
+                        .side_wrap_exclusions
+                        .contains_key(&(para_index, *index))
+                    && self.data.current_items.iter().any(|item| {
+                        matches!(item, PageItem::Table { para_index: p, control_index: c }
+                            if *p == para_index && *c == *index)
+                    })
+            })
+            .filter_map(|(_, control)| match control {
+                crate::model::control::Control::Table(table) => {
+                    frame.page_anchored_square_table_exclusion(table)
+                }
+                _ => None,
+            })
+            .collect()
+    }
+
