             render_normalization: std::sync::Arc::new(
                 crate::renderer::render_normalization::RenderNormalizationOverlay::default(),
@@ -3496,10 +3499,28 @@ impl TypesetEngine {
             .set(crate::renderer::stored_line_ladder_is_uniform_filler(
                 paragraphs, styles,
             ));
+        self.ladder_runs_past_body.set(None);
         *self.float_carve_evidence.borrow_mut() =
             crate::renderer::float_placement::paper_or_page_float_carve_evidence(paragraphs);
     }
 
+    /// 이 구역의 저장 줄 사다리가 본문 높이를 넘어 이어지는지(쪽 나눔을 담지 않은 저장본).
+    pub(crate) fn section_ladder_runs_past_body(
+        &self,
+        paragraphs: &[Paragraph],
+        body_height_px: f64,
+    ) -> bool {
+        if let Some(value) = self.ladder_runs_past_body.get() {
+            return value;
+        }
+        let value = crate::renderer::stored_line_ladder_runs_past_body(
+            paragraphs,
+            crate::renderer::px_to_hwpunit(body_height_px, self.dpi),
+        );
+        self.ladder_runs_past_body.set(Some(value));
+        value
+    }
