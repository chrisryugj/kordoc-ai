+/// 구역의 저장 줄 사다리가 쪽마다 되감기지 않고 본문 높이를 넘어 이어지는지 판정한다.
+///
+/// 한/글이 저장한 구역은 쪽(단)이 바뀔 때마다 첫 줄 `vertical_pos` 가 다시 작아지므로
+/// 줄 위쪽 좌표가 본문 높이를 넘지 않는다. 쪽을 나누지 않고 줄 좌표를 이어 붙인 생성기
+/// 문서는 둘째 쪽부터 본문 높이를 넘는다. 이런 구역은 저장 사다리가 쪽 나눔을 증언하지
+/// 않으므로 쪽 맞춤이 실제로 그리는 높이를 써야 한다. 합성 줄은 증거로 쓰지 않는다.
+pub(crate) fn stored_line_ladder_runs_past_body(
+    paragraphs: &[crate::model::paragraph::Paragraph],
+    body_height_hu: i32,
+) -> bool {
+    if body_height_hu <= 0 {
+        return false;
+    }
+    // 반올림·쪽 아래 넘침 줄을 한/글 저장본으로 잘못 보지 않도록 본문 높이의 1.5배를 쓴다.
+    let limit = body_height_hu.saturating_add(body_height_hu / 2);
+    paragraphs.iter().any(|para| {
+        para.line_segs.iter().any(|seg| {
+            seg.tag & crate::model::paragraph::LineSeg::TAG_IMPLEMENTATION_PROPERTY == 0
+                && seg.vertical_pos > limit
+        })
+    })
+}
