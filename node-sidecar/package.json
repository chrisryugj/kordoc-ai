{
  "name": "kordoc-sidecar",
  "version": "2.0.0",
  "description": "KorDoc AI Node.js sidecar — JSON-RPC 2.0 over stdin/stdout",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc",
    "build:bundle": "node esbuild.config.mjs && node scripts/stage-natives.mjs",
    "smoke": "node scripts/smoke-bundle.mjs",
    "dev": "tsx src/main.ts",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.129.0",
    "@hyzyla/pdfium": "2.1.13",
    "@pdf-lib/fontkit": "1.1.1",
    "@rhwp/core": "file:../vendor/rhwp-core",
    "@xmldom/xmldom": "^0.9.8",
    "cfb": "^1.2.2",
    "iconv-lite": "^0.7.3",
    "jszip": "^3.10.1",
    "kordoc": "4.22.18",
    "node-llama-cpp": "3.22.1",
    "pdf-lib": "^1.17.1",
    "puppeteer-core": "^24.0.0",
    "sharp": "0.35.5",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "esbuild": "^0.25.0",
    "jsdom": "^26.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vitest": "^3.1.0"
  }
}
