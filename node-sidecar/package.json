{
  "name": "kordoc-sidecar",
  "version": "1.0.0",
  "description": "KorDoc AI Node.js sidecar — JSON-RPC 2.0 over stdin/stdout",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc",
    "build:bundle": "node esbuild.config.mjs",
    "dev": "tsx src/main.ts",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.0",
    "@xmldom/xmldom": "^0.9.8",
    "cfb": "^1.2.2",
    "jszip": "^3.10.1",
    "kordoc": "link:../../kordoc",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.6.205",
    "puppeteer-core": "^24.0.0",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vitest": "^3.1.0"
  }
}
