{
  "name": "kordoc-sidecar",
  "version": "0.1.0",
  "description": "KorDoc AI Node.js sidecar — JSON-RPC 2.0 over stdin/stdout",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/main.ts",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.0",
    "kordoc": "^1.7.2",
    "pdfjs-dist": "^5.6.205",
    "yaml": "^2.7.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["canvas", "esbuild"]
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vitest": "^3.1.0"
  }
}
