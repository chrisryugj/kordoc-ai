{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KorDoc AI",
  "version": "1.4.1",
  "identifier": "com.kordoc-ai.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "pnpm build:all",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "KorDoc AI",
        "visible": false,
        "width": 1280,
        "height": 920,
        "resizable": true,
        "fullscreen": false,
        "minWidth": 960,
        "minHeight": 680
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: asset: https://asset.localhost; connect-src ipc: http://ipc.localhost 'self'; object-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "publisher": "KorDoc",
    "shortDescription": "HWP/HWPX/PDF/XLSX/DOCX 문서 변환·요약·비교·병합",
    "longDescription": "KorDoc AI는 관공서에서 사용하는 모든 문서 형식(HWP, HWPX, PDF, XLSX, DOCX)을 마크다운으로 변환하고, AI로 요약·비교·병합하는 데스크톱 도구입니다. 한컴오피스나 MS Office 없이 순수 JS 엔진(kordoc)으로 문서를 파싱합니다.",
    "copyright": "Copyright (c) 2026 KorDoc",
    "license": "MIT",
    "resources": {
      "../node-sidecar/dist/": "node-sidecar/dist/",
      "../node-sidecar/config/": "node-sidecar/config/"
    },
    "windows": {
      "wix": {
        "upgradeCode": "213AB368-C5C7-4FFC-BA1B-3B56095BD135",
        "language": "ko-KR"
      },
      "nsis": {
        "languages": ["Korean"],
        "displayLanguageSelector": false,
        "installMode": "both"
      }
    }
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
